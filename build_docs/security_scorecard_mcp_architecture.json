{
  "mcp_server": {
    "name": "security-scorecard-enterprise-server",
    "version": "0.1.0",
    "description": "Enterprise MCP server for Security Scorecard API integration, focused on security findings analysis and remediation planning",
    "purpose": "Provide AI-powered security analysis and remediation guidance for large organizations through natural language queries",
    "target_use_case": "Enterprise security teams managing hundreds/thousands of security findings with need for intelligent prioritization and remediation planning"
  },
  "technical_architecture": {
    "language": "TypeScript",
    "runtime": "Node.js >=18.0.0",
    "framework": "@modelcontextprotocol/sdk@^0.6.0",
    "transport": "StdioServerTransport",
    "build_system": "TypeScript Compiler (tsc)",
    "package_manager": "npm",
    "entry_point": "build/index.js",
    "source_structure": {
      "src/index.ts": "Main MCP server implementation",
      "package.json": "Project dependencies and scripts", 
      "tsconfig.json": "TypeScript compilation configuration",
      "build/": "Compiled JavaScript output directory"
    }
  },
  "api_integration": {
    "target_api": "Security Scorecard REST API",
    "base_url": "https://api.securityscorecard.io",
    "authentication": {
      "method": "Token-based",
      "header_format": "Authorization: Token {api_token}",
      "environment_variable": "SECURITY_SCORECARD_API_TOKEN"
    },
    "default_domain": "neste.com",
    "supported_formats": ["JSON"],
    "rate_limiting": "Handled by Security Scorecard API",
    "error_handling": "HTTP status codes with detailed error messages"
  },
  "configuration": {
    "environment_variables": {
      "SECURITY_SCORECARD_API_TOKEN": {
        "type": "string",
        "required": true,
        "description": "Security Scorecard API authentication token"
      },
      "COMPANY_DOMAIN": {
        "type": "string",
        "required": false,
        "default": "neste.com",
        "description": "Default company domain for analysis"
      }
    },
    "claude_desktop_integration": {
      "config_file": "%APPDATA%/Claude/claude_desktop_config.json",
      "server_name": "security-scorecard-enterprise",
      "command": "node",
      "args": ["C:\\Temp\\scorecard\\build\\index.js"]
    }
  },
  "data_structures": {
    "SecurityScorecardConfig": {
      "apiToken": "string",
      "defaultDomain": "string"
    },
    "FactorSummary": {
      "name": "string",
      "score": "number",
      "grade": "string", 
      "percentile": "number"
    },
    "FindingDetails": {
      "type": "string",
      "severity": "string",
      "count": "number",
      "description": "string",
      "remediation": "string",
      "affected_assets": "string[]",
      "first_seen": "string",
      "last_seen": "string"
    }
  },
  "implemented_tools": {
    "get_company_overview": {
      "description": "Get comprehensive security overview for your company including current score, grade, and key metrics",
      "api_endpoints": [
        "/companies/{domain}",
        "/companies/{domain}/factors"
      ],
      "parameters": {
        "domain": {
          "type": "string",
          "optional": true,
          "default": "neste.com"
        }
      },
      "output_format": "Formatted markdown with JSON data appendix",
      "business_value": "Executive-level security posture summary"
    },
    "get_current_findings": {
      "description": "Get all current security findings/issues for your company with detailed breakdown by category",
      "api_endpoints": [
        "/companies/{domain}/issues"
      ],
      "parameters": {
        "domain": {
          "type": "string", 
          "optional": true,
          "default": "neste.com"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"],
          "optional": true
        },
        "factor": {
          "type": "string",
          "optional": true
        },
        "limit": {
          "type": "number",
          "default": 100,
          "optional": true
        }
      },
      "data_processing": {
        "grouping": ["severity", "factor", "type"],
        "aggregation": ["counts", "asset_tracking"],
        "filtering": ["critical_assets", "top_issues"]
      },
      "output_format": "Categorized findings analysis with summary statistics",
      "business_value": "Comprehensive view of all security issues for prioritization"
    },
    "analyze_findings_by_priority": {
      "description": "Analyze and prioritize security findings based on risk impact, helping focus remediation efforts",
      "api_endpoints": [
        "/companies/{domain}/issues",
        "/companies/{domain}/factors"
      ],
      "parameters": {
        "domain": {
          "type": "string",
          "optional": true,
          "default": "neste.com"
        },
        "include_remediation": {
          "type": "boolean",
          "default": true,
          "optional": true
        }
      },
      "ai_algorithm": {
        "priority_scoring": {
          "severity_weights": {
            "critical": 100,
            "high": 75,
            "medium": 50,
            "low": 25
          },
          "factor_impact_multiplier": 0.5,
          "asset_criticality_bonus": 20
        },
        "sorting": "priority_score descending",
        "classification": {
          "CRITICAL": "> 80",
          "HIGH": "60-80", 
          "MEDIUM": "40-60",
          "LOW": "< 40"
        }
      },
      "output_format": "Ranked list of top 10 priority issues with remediation guidance",
      "business_value": "AI-powered prioritization for efficient resource allocation"
    },
    "get_factor_breakdown": {
      "description": "Get detailed breakdown of all 10 security factors with current scores and contributing issues",
      "api_endpoints": [
        "/companies/{domain}/factors"
      ],
      "parameters": {
        "domain": {
          "type": "string",
          "optional": true,
          "default": "neste.com"
        }
      },
      "output_format": "Detailed factor analysis with scores and percentiles",
      "business_value": "Understanding of security strengths and weaknesses by category"
    },
    "get_findings_by_asset": {
      "description": "Group security findings by affected assets (IP addresses, domains, subdomains) for targeted remediation",
      "api_endpoints": [
        "/companies/{domain}/issues"
      ],
      "parameters": {
        "domain": {
          "type": "string",
          "optional": true,
          "default": "neste.com"
        },
        "asset_type": {
          "type": "string",
          "enum": ["ip", "domain", "subdomain"],
          "optional": true
        }
      },
      "data_processing": {
        "grouping_logic": "asset-based clustering",
        "sorting": "risk-weighted by critical and high severity counts",
        "limit": "top 20 assets"
      },
      "output_format": "Asset-centric view with issue counts and top problems",
      "business_value": "Team-based assignment of remediation tasks by infrastructure ownership"
    },
    "get_historical_trend": {
      "description": "Analyze security score trends over time to track improvement/deterioration patterns",
      "api_endpoints": [
        "/companies/{domain}/history/score",
        "/companies/{domain}/history/factors/{factor}"
      ],
      "parameters": {
        "domain": {
          "type": "string",
          "optional": true,
          "default": "neste.com"
        },
        "months": {
          "type": "number",
          "default": 12,
          "optional": true
        },
        "factor": {
          "type": "string",
          "optional": true
        }
      },
      "output_format": "Historical trend analysis with time series data",
      "business_value": "Progress tracking and trend identification for strategic planning"
    },
    "get_remediation_plan": {
      "description": "Generate a prioritized remediation plan based on current findings and their business impact",
      "api_endpoints": [
        "/companies/{domain}/issues",
        "/companies/{domain}/factors"
      ],
      "parameters": {
        "domain": {
          "type": "string",
          "optional": true,
          "default": "neste.com"
        },
        "focus_area": {
          "type": "string",
          "optional": true
        },
        "timeline": {
          "type": "string",
          "enum": ["immediate", "30_days", "90_days", "annual"],
          "default": "90_days",
          "optional": true
        }
      },
      "output_format": "Structured remediation plan with timeline-based actions",
      "business_value": "Actionable roadmap for security improvement initiatives"
    },
    "compare_with_industry": {
      "description": "Compare your company's security posture with industry benchmarks and peers",
      "api_endpoints": [
        "/companies/{domain}",
        "/companies/{domain}/factors"
      ],
      "parameters": {
        "domain": {
          "type": "string",
          "optional": true,
          "default": "neste.com"
        },
        "industry": {
          "type": "string",
          "optional": true
        }
      },
      "output_format": "Comparative analysis with industry positioning",
      "business_value": "Competitive benchmarking and industry context for security posture"
    },
    "get_security_events": {
      "description": "Get recent security events and changes that affected your score",
      "api_endpoints": [
        "/companies/{domain}/events"
      ],
      "parameters": {
        "domain": {
          "type": "string",
          "optional": true,
          "default": "neste.com"
        },
        "days": {
          "type": "number",
          "default": 30,
          "optional": true
        },
        "event_type": {
          "type": "string",
          "optional": true
        }
      },
      "output_format": "Chronological event log with impact analysis",
      "business_value": "Understanding of recent changes and their security impact"
    },
    "create_improvement_alert": {
      "description": "Set up alerts to monitor security improvement progress",
      "api_endpoints": [
        "Internal configuration (would integrate with Security Scorecard alerts API)"
      ],
      "parameters": {
        "domain": {
          "type": "string",
          "optional": true,
          "default": "neste.com"
        },
        "metric": {
          "type": "string",
          "enum": ["overall_score", "factor_score", "issue_count"],
          "required": true
        },
        "target_value": {
          "type": "number",
          "required": true
        },
        "alert_name": {
          "type": "string",
          "required": true
        },
        "factor": {
          "type": "string",
          "optional": true
        }
      },
      "output_format": "Alert configuration confirmation",
      "business_value": "Automated monitoring of security improvement goals"
    }
  },
