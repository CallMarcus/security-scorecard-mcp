{
  "name": "security-scorecard-mcp",
  "version": "4.1.0",
  "description": "Compiled MCP server for the SecurityScorecard API",
  "main": "build/simplified-index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/simplified-index.js",
    "start:original": "node build/index.js",
    "start:simplified": "node build/simplified-index.js",
    "test": "node --test tests/*.test.js",
    "test:ts": "node --test tests/*.test.ts",
    "api:generate": "python build_simple_client.py",
    "api:test": "npm run test",
    "api:validate": "node examples/basic_usage.js",
    "api:update": "python split_swagger.py && python build_simple_client.py",
    "dev:api": "npm run api:update && npm run build",
    "validate": "python validate_mcp_tools.py",
    "validate:full": "powershell -ExecutionPolicy Bypass -File run_validation.ps1",
    "test:validation": "npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^17.2.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
